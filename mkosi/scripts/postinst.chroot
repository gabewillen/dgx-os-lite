#!/bin/bash
# PID 1 is finit (finit-sysv). udev from the udev package; sysusers/tmpfiles
# from systemd-standalone-* so we never install the systemd daemon.
set -e
export DEBIAN_FRONTEND=noninteractive

sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config

printf 'vm.swappiness=0\n' > /etc/sysctl.d/90-dgx-lite.conf
echo 'blacklist r8169' > /etc/modprobe.d/blacklist-r8169.conf
printf 'nameserver 1.1.1.1\n' > /etc/resolv.conf

mkdir -p /etc/default/grub.d
cat > /etc/default/grub.d/lite.cfg <<EOF
GRUB_CMDLINE_LINUX_DEFAULT="quiet console=ttyAMA0,115200 module_blacklist=r8169 crashkernel=0"
GRUB_TERMINAL="serial console"
GRUB_SERIAL_COMMAND="serial --unit=0 --speed=115200"
EOF

mkdir -p /etc/finit.d /etc/finit.d/available

cat > /etc/finit.conf <<'EOF'
# dgx-os-lite — finit bootstrap
runlevel 2
run [S] sysctl --system -- Apply sysctl
run [S] /usr/bin/ssh-keygen -A -- SSH host keys
tty [12345] /dev/ttyAMA0 vt100 noclear nowait
tty [12345] /dev/tty1 linux noclear nowait
EOF

cat > /etc/finit.d/available/dhcpcd.conf <<'EOF'
service [2345] <service/udevd/ready> /usr/sbin/dhcpcd -B -- DHCP
EOF

cat > /etc/finit.d/available/sshd.conf <<'EOF'
service [2345] <net/lo/up> env:-/etc/default/ssh /usr/sbin/sshd -D $SSHD_OPTS -- OpenSSH
EOF

cat > /etc/finit.d/available/mdnsd.conf <<'EOF'
# -H rewritten at install to factory hostname (gx10-5e36 / spark-xxxx)
service [2345] <net/lo/up> /usr/sbin/mdnsd -sn -- mDNS
EOF

cat > /etc/finit.d/available/nvidia-persistenced.conf <<'EOF'
service nowarn [2345] <service/udevd/ready> /usr/bin/nvidia-persistenced --persistence-mode -- NVIDIA persistenced
EOF

ln -sfn /etc/finit.d/available/dhcpcd.conf /etc/finit.d/dhcpcd.conf
ln -sfn /etc/finit.d/available/sshd.conf /etc/finit.d/sshd.conf
ln -sfn /etc/finit.d/available/mdnsd.conf /etc/finit.d/mdnsd.conf
ln -sfn /etc/finit.d/available/nvidia-persistenced.conf /etc/finit.d/nvidia-persistenced.conf

echo "dgx-spark-lite postinst complete (finit)" >&2
