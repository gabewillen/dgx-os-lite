#!/usr/bin/env bash
# Shared helpers for install stages. Sourced, not executed.

msg() { printf '[install] %s\n' "$*"; }
die() { printf '[install] FATAL: %s\n' "$*" >&2; exit 1; }
run() {
  if [[ "${DRY_RUN:-0}" == 1 ]]; then
    msg "DRY-RUN: $*"
    return 0
  fi
  "$@"
}

dmi() { cat "/sys/class/dmi/id/$1" 2>/dev/null || true; }

require_bin() {
  command -v "$1" >/dev/null || die "missing required tool: $1"
}

cleanup() {
  umount /mnt/dgx-lite-new 2>/dev/null || true
  umount /mnt/dgx-lite-esp 2>/dev/null || true
}

part_type() { lsblk -no PARTTYPE "$1" 2>/dev/null | head -1 | tr '[:upper:]' '[:lower:]'; }

is_esp() {
  local ptype
  ptype=$(part_type "$1")
  [[ "$ptype" == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" ]]
}

is_protected() {
  is_esp "$1" && return 0
  case "$(part_type "$1")" in
    e3c9e316-0b5c-4db8-817d-f92df00215ae) return 0 ;; # MSR
  esac
  return 1
}

is_os_candidate() {
  local ptype fstype
  is_protected "$1" && return 1
  ptype=$(part_type "$1")
  fstype=$(blkid -o value -s TYPE "$1" 2>/dev/null || true)
  case "$ptype" in
    0fc63daf-8483-4772-8e79-3d69d8477de4| \
    44479540-f297-41b2-9af7-d131d5f0458a| \
    69dad710-2ce4-4e3c-b16c-21a1d49abed3| \
    b921b045-1df0-41c3-af44-4c6f280d3fae)
      return 0 ;;
  esac
  case "$fstype" in
    ext4|xfs|btrfs|f2fs|ext2|ext3) return 0 ;;
  esac
  return 1
}

find_internal_disk() {
  if [[ -n "${DGX_LITE_DISK:-}" ]]; then
    [[ -b "$DGX_LITE_DISK" ]] || die "DGX_LITE_DISK=$DGX_LITE_DISK is not a block device"
    echo "$DGX_LITE_DISK"
    return 0
  fi
  local d name
  for d in /sys/class/block/nvme*n[0-9]; do
    [[ -e "$d" ]] || continue
    name=$(basename "$d")
    [[ "$name" == *"p"* ]] && continue
    echo "/dev/$name"
    return 0
  done
  die "no internal NVMe found"
}
