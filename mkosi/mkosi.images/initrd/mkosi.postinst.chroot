#!/bin/bash
# PID 1 in the initrd is busybox sh /init — never systemd.
set -e
ln -sf /bin/busybox /bin/sh
busybox --install -s /bin 2>/dev/null || true

cat > /init <<'EOF'
#!/bin/sh
set -e
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mkdir -p /dev/pts /dev/shm /run
mount -t devpts devpts /dev/pts 2>/dev/null || true

if [ -d /lib/modules ]; then
  kver=$(uname -r)
  [ -f /lib/modules/$kver/modules.dep ] || depmod "$kver" 2>/dev/null || true
  for m in virtio_pci virtio_blk virtio_scsi nvme nvme_core xfs ext4 overlay sd_mod ahci vfat nls_cp437 nls_iso8859-1; do
    modprobe "$m" 2>/dev/null || true
  done
fi

root=
init=/usr/sbin/finit
for tok in $(cat /proc/cmdline); do
  case "$tok" in
    root=*) root=${tok#root=} ;;
    init=*) init=${tok#init=} ;;
  esac
done

if [ -z "$root" ]; then
  echo "initrd: no root= on cmdline" >&2
  exec /bin/sh
fi

mkdir -p /newroot
tries=0
mounted=0
while [ $tries -lt 50 ]; do
  case "$root" in
    PARTUUID=*)
      pu=${root#PARTUUID=}
      dev=$(blkid -t PARTUUID="$pu" -o device 2>/dev/null || true)
      ;;
    UUID=*)
      uu=${root#UUID=}
      dev=$(blkid -t UUID="$uu" -o device 2>/dev/null || true)
      ;;
    *)
      dev=$root
      ;;
  esac
  if [ -n "$dev" ] && mount -o ro "$dev" /newroot 2>/dev/null; then
    mounted=1
    break
  fi
  tries=$((tries + 1))
  sleep 0.2
done

if [ "$mounted" != 1 ]; then
  echo "initrd: failed to mount $root" >&2
  blkid || true
  exec /bin/sh
fi

mount -o remount,rw /newroot 2>/dev/null || true

if [ -x /newroot/usr/sbin/finit ]; then
  init=/usr/sbin/finit
elif [ -x "/newroot$init" ]; then
  :
else
  echo "initrd: no finit at /usr/sbin/finit" >&2
  exec /bin/sh
fi

umount /proc 2>/dev/null || true
umount /sys 2>/dev/null || true
exec switch_root /newroot "$init"
EOF
chmod 755 /init
echo "busybox initrd /init written" >&2
